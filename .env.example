# ===============================================
# NU PROJECT SHOWCASER - ENVIRONMENT VARIABLES
# ===============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# ===============================================
# SERVER CONFIGURATION
# ===============================================

# Port number for the server to listen on
PORT=3000

# Node environment: 'development' or 'production'
NODE_ENV=development

# ===============================================
# DATABASE CONFIGURATION
# ===============================================

# MongoDB connection string
# Development: mongodb://localhost:27017/nu-project-showcaser
# Production: Use MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/nu-project-showcaser

# ===============================================
# SESSION CONFIGURATION
# ===============================================

# Secret key for session encryption
# Generate a strong random string for production
# Example: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# ===============================================
# JWT AUTHENTICATION
# ===============================================

# Secret key for JWT token signing and verification
# Generate a strong random string for production
# Example: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# ===============================================
# AZURE AD OAUTH CONFIGURATION
# ===============================================

# Azure AD Tenant ID
# Found in Azure Portal -> Azure Active Directory -> Overview
AZURE_TENANT_ID=your-azure-tenant-id

# Azure AD Application (client) ID
# Found in Azure Portal -> App registrations -> Your App
AZURE_CLIENT_ID=your-azure-client-id

# Azure AD Client Secret
# Created in Azure Portal -> App registrations -> Your App -> Certificates & secrets
AZURE_CLIENT_SECRET=your-azure-client-secret

# OAuth callback URL
# Development: http://localhost:3000/auth/callback
# Production: https://your-domain.com/auth/callback
# This MUST match the redirect URI in Azure AD App registration
AZURE_REDIRECT_URL=http://localhost:3000/auth/callback

# ===============================================
# SUPABASE STORAGE CONFIGURATION
# ===============================================

# Supabase project URL
# Found in Supabase Dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service role key (for backend operations, bypasses RLS)
# Found in Supabase Dashboard -> Settings -> API -> service_role key
# IMPORTANT: Keep this secret! Never expose in frontend
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Alternative: Supabase anon key (if not using service role)
# SUPABASE_KEY=your-supabase-anon-key

# ===============================================
# FRONTEND URL CONFIGURATION
# ===============================================

# Comma-separated list of allowed frontend URLs (no spaces)
# Used for CORS and origin validation
# Development example: http://localhost:5173,http://localhost:3001
# Production example: https://yourapp.com,https://www.yourapp.com
FRONTEND_URLS=http://localhost:5173

# ===============================================
# EMAIL CONFIGURATION (NODEMAILER)
# ===============================================

# SMTP server hostname
# Gmail: smtp.gmail.com
# Outlook: smtp-mail.outlook.com
# SendGrid: smtp.sendgrid.net
EMAIL_HOST=smtp.gmail.com

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (unencrypted)
EMAIL_PORT=587

# Use secure connection (true for SSL, false for TLS/STARTTLS)
EMAIL_SECURE=false

# Email account username
EMAIL_USER=your-email@gmail.com

# Email account password or app-specific password
# For Gmail, generate an app password at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-app-specific-password

# Optional: Email sender name and address for outgoing emails
EMAIL_FROM_NAME=NU Project Showcaser
EMAIL_FROM_ADDRESS=noreply@your-domain.com

# ===============================================
# OPTIONAL: FILE UPLOAD LIMITS
# ===============================================

# Maximum file size for image uploads (in bytes)
# Default: 5MB = 5 * 1024 * 1024 = 5242880
# MAX_IMAGE_SIZE=5242880

# Maximum file size for video uploads (in bytes)
# Default: 100MB = 100 * 1024 * 1024 = 104857600
# MAX_VIDEO_SIZE=104857600

# ===============================================
# OPTIONAL: RATE LIMITING (if implemented)
# ===============================================

# Maximum number of requests per window
# RATE_LIMIT_MAX=100

# Time window in milliseconds
# RATE_LIMIT_WINDOW=900000

# ===============================================
# NOTES
# ===============================================
#
# 1. After copying this file to .env, fill in all values
# 2. Never commit .env to version control
# 3. Keep production secrets secure
# 4. Rotate secrets regularly
# 5. Use strong, random values for SESSION_SECRET and JWT_SECRET
# 6. Ensure Azure redirect URL matches exactly in Azure Portal
# 7. For production, use environment-specific values
# 8. Test with development values before deploying
#
# ===============================================
