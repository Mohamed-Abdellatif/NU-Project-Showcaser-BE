# Server Configuration
PORT=3000
NODE_ENV=development

# Database
# Local MongoDB: mongodb://localhost:27017/nu-project-showcaser
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb://localhost:27017/nu-project-showcaser

# Session Security
# Generate a strong random string for production
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# JWT Authentication
# Generate a strong random string for production
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Azure AD OAuth Configuration
# Get these from Azure Portal > Azure Active Directory > App registrations
AZURE_TENANT_ID=your-azure-tenant-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
# Development: http://localhost:3000/auth/callback
# Production: https://your-domain.com/auth/callback
AZURE_REDIRECT_URL=http://localhost:3000/auth/callback

# Supabase Storage
# Get these from Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Alternative variable name (fallback)
SUPABASE_KEY=your-supabase-service-role-key

# Frontend URLs (comma-separated, no spaces)
# Development: http://localhost:5173
# Production: https://your-frontend-domain.com
FRONTEND_URLS=http://localhost:5173

# Frontend Redirect URLs (optional - defaults provided in code)
FRONTEND_HOME_URL=http://localhost:5173/
FRONTEND_FIRST_LOGIN_REDIRECT_URL=http://localhost:5173/complete-profile
FRONTEND_DASHBOARD_URL=http://localhost:5173/

# Email Configuration (Nodemailer)
# For Gmail: Use App Password (not regular password)
# For Outlook/Office365: Enable SMTP AUTH in Microsoft 365 Admin Center
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-specific-password

# SMTP Configuration (optional - auto-detected for Gmail/Outlook)
# Only needed for custom SMTP servers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
